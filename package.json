{
  "name": "mini-games-story-1",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "lint": "eslint \"src/**/*.{ts,js}\" --max-warnings=0",
    "format": "prettier --write \"src/**/*.{ts,scss,html,md,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,scss,html,md,json}\"",
    "prepare": "husky install"
  },
  "devDependencies": {
    "vite": "^5.0.0",
    "typescript": "^5.0.0",
    "eslint": "^8.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "prettier": "^2.0.0",
    "husky": "^8.0.0",
    "lint-staged": "^13.0.0",
    "sass": "^1.0.0"
  },
  "lint-staged": {
    "src/**/*.{ts,js}": [
      "npm run lint",
      "npm run format"
    ],
    "src/**/*.{scss,html,md,json}": [
      "npm run format"
    ]
  }
}